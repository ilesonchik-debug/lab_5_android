<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/departure_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="8dp" />

        <AutoCompleteTextView
            android:id="@+id/etDeparture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/departure_hint"
            android:inputType="text"
            android:padding="14dp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvFlightsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/flights_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvEmptyFlights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/empty_flights"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:gravity="center"
            android:padding="20dp" />

        <LinearLayout
            android:id="@+id/llFlights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvFavoritesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/favorites_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvEmptyFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/empty_favorites"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:gravity="center"
            android:padding="20dp" />

        <LinearLayout
            android:id="@+id/llFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>